# Copy to .env — Docker Compose reads it automatically.
# (For running the server without Docker, see server/.env.example.)

# Secret required to save changes from /admin. Leave empty and anyone who
# finds the admin page can edit the site, so set it before going public.
# Generate one with: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=

# Port published on the host. The container always listens on 4000.
HOST_PORT=4000

# Browser origin(s) allowed to call the API — only needed if the API is
# called from a different domain than the site. Comma-separated, or *.
# CORS_ORIGIN=https://rggeneralcontracts.com

# Largest image or video the admin page may upload, in megabytes.
# MAX_UPLOAD_MB=200

# Public address of the site. Used for canonical links, link previews, and
# sitemap.xml — set it once the domain is live.
# SITE_URL=https://rggeneralcontracts.com
