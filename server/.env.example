# Copy to .env and adjust. Load it with `node --env-file=.env src/index.js`
# (or set these in your host's environment).

# Port the API listens on.
PORT=4000

# Shared secret required by write endpoints (POST/PUT/DELETE).
# Leave unset for local development; ALWAYS set a long random value in
# production, otherwise anyone can edit the site content.
# Generate one with: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=

# Allowed browser origin(s) for the API — comma-separated, or * for any.
CORS_ORIGIN=http://localhost:3000

# Where db.json lives. Defaults to ./data next to the server.
# DATA_DIR=/var/lib/rg

# Built frontend to serve. Defaults to ../dist.
# CLIENT_DIST=/srv/rg/dist
