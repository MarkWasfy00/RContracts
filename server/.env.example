# Copy to .env and adjust. Load it with `node --env-file=.env src/index.js`
# (or set these in your host's environment).

# Port the API listens on.
PORT=4000

# Shared secret required by write endpoints (POST/PUT/DELETE).
# Leave unset for local development; ALWAYS set a long random value in
# production, otherwise anyone can edit the site content.
# Generate one with: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=

# Allowed browser origin(s) for the API — comma-separated, or * for any.
CORS_ORIGIN=http://localhost:3000

# Where db.json and the uploaded images/videos live. Defaults to ./data
# next to the server.
# DATA_DIR=/var/lib/rg

# Largest file /admin may upload, in megabytes. Videos are why this is high.
# MAX_UPLOAD_MB=200

# Built frontend to serve. Defaults to ../dist.
# CLIENT_DIST=/srv/rg/dist

# Canonical origin used in the SEO tags (canonical, Open Graph, sitemap).
# Defaults to the requesting host, which is fine locally — set it in
# production so every page advertises one URL.
# SITE_URL=https://rggeneralcontracts.com
